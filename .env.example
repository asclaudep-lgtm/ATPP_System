# ATPP System environment variables
# Скопируйте этот файл в .env и заполните реальными значениями.

# Database: sqlite:///data/atpp.db (локально) или postgresql://user:pass@host/dbname (LAN)
DATABASE_URL=sqlite:///data/atpp.db

# Web server
ATPP_WEB_SECRET=change-me-in-production
ATPP_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# IoT (MQTT broker)
ATPP_MQTT_HOST=localhost
ATPP_MQTT_PORT=1883

# 1C Exchange
ATPP_1C_API_URL=
ATPP_1C_API_KEY=
